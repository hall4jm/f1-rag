# Copy to .env and fill in. Anything left blank uses the default in config.py.

# --- LLM provider selection ---
# One of: anthropic | openai | groq | ollama
# Recommended for public deploy: groq (free tier, no per-request cost).
LLM_PROVIDER=groq
# Optional override. If unset, config.py picks a provider-appropriate default:
#   anthropic -> claude-haiku-4-5-20251001
#   openai    -> gpt-4o-mini
#   groq      -> llama-3.3-70b-versatile
#   ollama    -> llama3.2:3b
# LLM_MODEL=

# --- API keys (only the active provider's key is required) ---
# Groq is free-tier; sign up at https://console.groq.com to get a key.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Groq endpoint (only override if Groq changes paths) ---
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (only used when LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://localhost:11434

# --- Embeddings ---
# Local sentence-transformers model. BGE-v1.5 is trained for asymmetric query/passage
# retrieval and handles question-shaped queries much better than MiniLM.
# The bge-small variant is ~130 MB, 384-dim, CPU-friendly.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Storage and external APIs ---
CHROMA_DIR=chroma_db
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1/

# --- Wikipedia scraping ---
# Wikipedia's API policy expects contact info. Edit the URL or add an email
# before doing serious bulk runs.
WIKI_USER_AGENT=f1-rag/0.1 (https://github.com/your-github/f1-rag)
